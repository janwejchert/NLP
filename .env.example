# Copy this file to `.env` and fill in values. `.env` is gitignored.

# Which extraction backend to use:
#   ollama -> local model (development + the reproducible evaluation run)
#   hf     -> Hugging Face Inference API (the hosted Streamlit Cloud demo)
EXTRACTOR_BACKEND=ollama

# Model name.
#   For ollama: a pulled tag, e.g. qwen2.5:3b  (or qwen2.5:7b for higher accuracy)
#   For hf:     a hosted model id, e.g. Qwen/Qwen2.5-7B-Instruct
MODEL_NAME=qwen2.5:3b

# Hugging Face access token (Read scope). REQUIRED only when EXTRACTOR_BACKEND=hf.
# Create a free one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: override the Ollama server location (defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
